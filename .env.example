# SelfHeal — Environment Configuration
# Get your Gemini API key at: https://aistudio.google.com/apikey
# Multiple keys for rotation/failover (comma-separated)
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3

# Confidence threshold (0.0–1.0) — heals below this require human approval
CONFIDENCE_THRESHOLD=0.80

# Safe mode: when true, low-confidence heals are blocked until approved
SAFE_MODE=false

# Dashboard & WebSocket ports
DASHBOARD_PORT=3000
WS_PORT=3001

# SQLite database path
DB_PATH=./data/heals.db

# Per-step timeout before triggering heal (ms)
STEP_TIMEOUT_MS=60000

# Max heal retry attempts per selector
MAX_RETRIES=3
