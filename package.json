{
  "name": "selfheal",
  "version": "1.0.0",
  "description": "Self-healing Playwright test runner powered by Gemini AI",
  "type": "module",
  "main": "src/runner/playwrightRunner.js",
  "bin": {
    "selfheal": "./bin/selfheal.js"
  },
  "scripts": {
    "start": "node bin/selfheal.js",
    "dev": "node bin/selfheal.js run tests/checkout.spec.js --dashboard",
    "test": "playwright test",
    "postinstall": "echo \"\\nNote: better-sqlite3 requires Python and C++ build tools on Windows. If install fails, run: npm install --global windows-build-tools\\n\""
  },
  "keywords": [
    "playwright",
    "self-healing",
    "test-automation",
    "cli",
    "ai",
    "gemini"
  ],
  "author": "srujakwarbhuvan",
  "repository": {
    "type": "git",
    "url": "https://github.com/srujakwarbhuvan/SelfHeal"
  },
  "homepage": "https://github.com/srujakwarbhuvan/SelfHeal#readme",
  "files": [
    "src",
    "bin",
    "dashboard",
    "selfheal.config.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "open": "^10.1.0",
    "socket.io": "^4.7.0",
    "recast": "^0.23.9",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}